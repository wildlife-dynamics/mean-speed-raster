{
  "properties": {
    "er_connection": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "description": "Select one of your configured data sources.",
          "title": ""
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Connect to Earthranger"
    },
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Set Workflow Details"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "description": "The start time",
          "format": "date-time",
          "title": "Since",
          "type": "string"
        },
        "until": {
          "description": "The end time",
          "format": "date-time",
          "title": "Until",
          "type": "string"
        },
        "timezone": {
          "$ref": "#/$defs/TimezoneInfo",
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Set Time Range"
    },
    "subjectgroup_observations": {
      "additionalProperties": false,
      "properties": {
        "subject_group_name": {
          "description": "\u26a0\ufe0f The use of a group with mixed subtypes could lead to unexpected results",
          "title": "Subject Group Name",
          "type": "string"
        }
      },
      "required": [
        "subject_group_name"
      ],
      "type": "object",
      "title": "Subject Group"
    },
    "ecograph_gdf": {
      "additionalProperties": false,
      "properties": {
        "cutoff": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cutoff distance for kernel.",
          "ecoscope:advanced": true,
          "title": "Cutoff"
        },
        "step_length": {
          "anyOf": [
            {
              "exclusiveMaximum": 100000,
              "exclusiveMinimum": 500,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 2000,
          "description": "Mean step length, used as the resolution if `resolution` is None.",
          "ecoscope:advanced": true,
          "title": "Step Length"
        }
      },
      "required": [],
      "type": "object",
      "title": "Build Ecograph"
    }
  },
  "$defs": {
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    },
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "time_range": {
      "ui:order": [
        "since",
        "until",
        "timezone"
      ]
    },
    "ecograph_gdf": {
      "ui:order": [
        "cutoff",
        "step_length"
      ]
    },
    "ui:order": [
      "er_connection",
      "workflow_details",
      "time_range",
      "subjectgroup_observations",
      "ecograph_gdf"
    ]
  },
  "additionalProperties": false
